# Appwrite Backend Configuration for ParkPuduvai
# Create a free project at https://cloud.appwrite.io

# 1. Your Appwrite Endpoint (Default is cloud)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# 2. Your Appwrite Project ID (Found in Appwrite Console > Project Settings)
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here

# 3. Database ID
EXPO_PUBLIC_APPWRITE_DATABASE_ID=park_puduvai_db

# 4. Optional Secret API Key (Used to automatically provision the database with scripts/setup_appwrite.js)
APPWRITE_API_KEY=your_secret_api_key_here
